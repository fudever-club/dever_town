# ===============================================
# DEVER TOWN — Environment Variables Configuration
# ===============================================

# Server Port
PORT=3001

# JWT Secret (Bắt buộc phải đổi thành chuỗi ngẫu nhiên dài khi chạy production)
JWT_SECRET=dever_town_secure_random_jwt_secret_key_change_in_production_2026

# Node Environment ('development' | 'production')
NODE_ENV=development

# Email Verification (Resend API hoặc SMTP tuỳ chọn)
RESEND_API_KEY=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=club.dever@gmail.com
# SMTP_PASS=
